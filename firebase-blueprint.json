{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Global platform user account with role-based access control.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "BUSINESS_OWNER", "MANAGER", "STAFF", "CUSTOMER"] },
        "fullName": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["uid", "email", "role"]
    },
    "Business": {
      "title": "Business Entity",
      "description": "Represents a salon, spa, or service provider tenant on the Nexora platform.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique business ID" },
        "name": { "type": "string", "description": "Legal business name" },
        "slug": { "type": "string", "description": "URL-friendly slug" },
        "ownerId": { "type": "string", "description": "UID of the business owner" },
        "verificationStatus": { 
          "type": "string", 
          "enum": ["pending", "under_review", "verified", "rejected", "suspended"],
          "description": "Current trust status of the entity (publicly visible verification state)"
        },
        "verificationSubmittedAt": { "type": "string", "format": "date-time" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "verifiedBy": { "type": "string", "description": "UID of the admin who approved (Sensitive)" },
        "rejectionReason": { "type": "string", "description": "Private reason if rejected" },
        "suspensionReason": { "type": "string", "description": "Private reason if suspended" },
        "verificationNotes": { "type": "string", "description": "Internal admin audit notes (Sensitive)" },
        "isFeatured": { "type": "boolean" },
        "featuredUntil": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "ownerId", "verificationStatus"]
    },
    "BusinessVerificationHistory": {
      "title": "Business Verification History",
      "description": "Historical audit log of all verification status transitions for auditing without overwriting past data.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique audit record ID" },
        "businessId": { "type": "string", "description": "Foreign key to business" },
        "previousStatus": { "type": "string", "description": "Previous verification status before update" },
        "newStatus": { "type": "string", "description": "New verification status" },
        "reason": { "type": "string", "description": "Reason for rejection, suspension, or approval notes" },
        "notes": { "type": "string", "description": "Internal auditor notes" },
        "changedBy": { "type": "string", "description": "UID of the admin or system who made the change" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of status change" }
      },
      "required": ["businessId", "newStatus", "changedBy", "createdAt"]
    }
  },
  "firestore": {
    "/profiles/{uid}": {
      "schema": "User",
      "description": "Authenticated user profiles with RBAC roles"
    },
    "/businesses/{businessId}": {
      "schema": "Business",
      "description": "Global registry of all platform tenants"
    },
    "/business_verification_history/{historyId}": {
      "schema": "BusinessVerificationHistory",
      "description": "Dedicated verification audit log for compliance and trust engine"
    }
  }
}
